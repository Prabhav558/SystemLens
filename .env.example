# SystemLens environment variables.
#
# Copy to .env and fill in what you use; leave the rest empty. .env is git-ignored.
# The CLI does not read this file on its own. Load it in one of these ways:
#
#   shell:           set -a; source .env; set +a
#   background:      cp .env ~/.systemlens/env && chmod 600 ~/.systemlens/env
#                    (read by the service from `agent service install`)
#   docker compose:  docker compose --env-file .env -f deploy/docker-compose.central.yml up -d
#
# Settings that are not secrets (provider, model, cooldowns, retention, ...) live in
# ~/.systemlens/config.yaml instead; see examples/config.example.yaml.

# --- LLM provider --------------------------------------------------------------
# Needed when llm.provider is groq. Not used with ollama.
GROQ_API_KEY=

# --- Data location ---------------------------------------------------------------
# Where config, project history and the central database live. Default: ~/.systemlens
# SYSTEMLENS_HOME=

# --- Notifications (optional) ------------------------------------------------------
# Each target is active when its variable is set. Test with `agent notify-test`.
SYSTEMLENS_SLACK_WEBHOOK=
SYSTEMLENS_DISCORD_WEBHOOK=
# Any URL; receives each finding as JSON.
SYSTEMLENS_WEBHOOK_URL=

# --- Pushing findings to a central server (optional) ---------------------------------
# The sla_... key printed by `agent central register-agent <name>`. Also set
# sinks.http_enabled: true and sinks.http_url in config.yaml.
SYSTEMLENS_HTTP_TOKEN=

# --- Running the central server (optional) -------------------------------------------
# Enables POST /agents/register for registering agents remotely. Leave empty to keep
# registration to `agent central register-agent` on the server itself.
# Generate with: openssl rand -hex 32
SYSTEMLENS_CENTRAL_ADMIN_KEY=
# Public hostname for deploy/docker-compose.central.yml; Caddy gets its TLS certificate.
SYSTEMLENS_DOMAIN=

# --- Running the agent in a container (optional) ---------------------------------------
# Project directory for deploy/docker-compose.agent.yml, mounted at the same path.
PROJECT_DIR=
